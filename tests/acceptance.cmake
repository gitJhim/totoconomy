function(ok)
 execute_process(COMMAND "${ECON}" ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "CLI failed (${result}): ${ARGV}\n${error}\n${output}")
 endif()
 set(last_output "${output}" PARENT_SCOPE)
endfunction()
function(reject expected)
 execute_process(COMMAND "${ECON}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
 if(NOT result EQUAL expected)
  message(FATAL_ERROR "Expected exit ${expected}, got ${result}: ${ARGN}\n${error}")
 endif()
endfunction()
ok(run --scenario "${SOURCE}/scenarios/accounting_cycle.json" --seed 42 --until-day 30 --trace audit --out "${OUT}/accounting" --overwrite)
ok(verify --run "${OUT}/accounting" --json)
string(JSON produced GET "${last_output}" totals production food)
string(JSON consumed GET "${last_output}" totals consumption food)
string(JSON cash GET "${last_output}" total_cash)
if(NOT produced EQUAL 180 OR NOT consumed EQUAL 180 OR NOT cash EQUAL 9000)
 message(FATAL_ERROR "Wrong accounting results: ${last_output}")
endif()
ok(run --scenario "${SOURCE}/scenarios/demo_town.json" --seed 42 --until-day 60 --checkpoint-every-days 15 --trace audit --out "${OUT}/baseline" --overwrite)
string(JSON baseline_digest GET "${last_output}" state_digest)
ok(inspect --run "${OUT}/baseline" --entity household:7 --json)
# Read an ID actually emitted by the run, rather than fabricating evidence.
file(STRINGS "${OUT}/baseline/decisions.jsonl" first_decision LIMIT_COUNT 1)
string(JSON decision_id GET "${first_decision}" id)
ok(explain --run "${OUT}/baseline" --decision "${decision_id}" --json)
ok(resume --checkpoint "${OUT}/baseline/checkpoints/day-0030.json" --until-day 60 --out "${OUT}/resumed" --overwrite)
string(JSON resumed_digest GET "${last_output}" state_digest)
ok(branch --checkpoint "${OUT}/baseline/checkpoints/day-0030.json" --intervention "${SOURCE}/scenarios/interventions/noop.json" --until-day 60 --out "${OUT}/noop" --overwrite)
string(JSON noop_digest GET "${last_output}" state_digest)
if(NOT baseline_digest STREQUAL resumed_digest OR NOT baseline_digest STREQUAL noop_digest)
 message(FATAL_ERROR "Resume/noop canonical state mismatch")
endif()
ok(branch --checkpoint "${OUT}/baseline/checkpoints/day-0030.json" --intervention "${SOURCE}/scenarios/interventions/public_price_board.json" --until-day 60 --out "${OUT}/board" --overwrite)
ok(compare --baseline "${OUT}/baseline" --variant "${OUT}/board" --from-day 30 --until-day 60 --json)
ok(verify --run "${OUT}/board" --json)
ok(benchmark --scenario "${SOURCE}/scenarios/demo_town.json" --seed 42 --until-day 3 --trace summary --out "${OUT}/benchmark-smoke" --overwrite --json)
reject(2 run --scenario "${SOURCE}/scenarios/demo_town.json" --seed 42 --until-day 1 --out "${OUT}/bad" --typo yes)
reject(2 inspect --run "${OUT}/baseline" --entity household:99999 --json)
reject(2 validate --scenario "${SOURCE}/scenarios/accounting_cycle.json" --json --json)
reject(3 run --scenario "${SOURCE}/scenarios/accounting_cycle.json" --seed 42 --until-day 30 --out "${OUT}/accounting")
reject(4 compare --baseline "${OUT}/baseline" --variant "${OUT}/resumed" --from-day 0 --until-day 60 --json)
reject(2 resume --checkpoint "${OUT}/baseline/checkpoints/day-0030.json" --until-day 29 --out "${OUT}/earlier")
reject(2 run --scenario "${SOURCE}/scenarios/accounting_cycle.json" --seed 9223372036854775808 --until-day 1 --out "${OUT}/bad")
